DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
SEED_DEMO_DATA=false

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_MOBILE=

# Brevo transactional email — SERVER ONLY.
# These must never be exposed to the browser: no NEXT_PUBLIC_ / VITE_ prefix,
# and they are read only inside src/server/brevo.js.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MPSC Pulse

# Razorpay checkout — SERVER ONLY.
# Keep these on the backend. Never expose the secret to the browser or APK.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SUPPORT_EMAIL=hyperboy022@gmail.com
NEXT_PUBLIC_SUPPORT_EMAIL=

# Cloudinary course-thumbnail uploads — SERVER ONLY.
# The API secret signs upload requests on the backend; the browser only ever
# receives a short-lived signature, never the secret itself.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

